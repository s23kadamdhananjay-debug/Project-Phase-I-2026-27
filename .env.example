# ---------------------------------------------------------------------------
# Agriculture Portal - environment configuration
# Copy this file to .env (never commit .env) and fill in the values you need.
# ---------------------------------------------------------------------------

# Application
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost/agbramha

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agriculture_portal
DB_USER=root
DB_PASSWORD=

# OpenAI - chatbot + rotating homepage quote
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap - 5 day weather forecast
OPENWEATHER_API_KEY=

# NewsAPI - agriculture news feed
NEWS_API_KEY=

# Stripe - online crop payments (leave blank to use demo checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Set to 1 to let customers place orders without a payment provider.
STRIPE_DEMO_MODE=1

# Gmail / SMTP - OTP and contact emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Agriculture Portal

# Python executable used by the ML features (python, python3 or a full path)
PYTHON=python
